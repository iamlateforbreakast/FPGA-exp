// Tang Nano 4K (GW1NSR-LV4CQN48PC7/I6) constraints for the OLED SPI design.
// Verified against Sipeed's official pinout diagram (wiki.sipeed.com/hardware/en/tang/Tang-Nano-4K).
//
// SCLK/SDIN/CS/DC use header pins 39/40/42/41 - physical, breadboard-
// accessible Bank1 (3.3V) pins, shared with the unused DVP camera interface
// (fine, since this design doesn't use the camera).
//
// This module is SH1106-based (1.3" 128x64), not SSD1306, and - unlike the
// assumption an earlier revision of this file made - it has no autonomous
// power-on reset circuit: RES must actually be pulsed low by the FPGA (see
// Top's oled_rst_cnt) or the chip never leaves its
// undefined post-power-up state no matter what commands follow. Wire the
// module's RES pin to o_reset (pin 43) rather than tying it to 3V3.

IO_LOC "clock" 45;
IO_PORT "clock" PULL_MODE=UP;

// Onboard button (USR_KEY_2), active-low on this board: pulled up, pressing
// pulls to 0 - opposite polarity from the Nano 20K's i_reset wiring
// (PULL_MODE=DOWN, active-high).
//
// IO_TYPE must be LVCMOS18, NOT LVCMOS33: pin 15 is in Bank3, whose VCCIO on
// this board is 1.8V (see Sipeed's pinmap). Declaring LVCMOS33 here asks for
// a 3.3V input buffer, whose VIH minimum (~2.0V) is *above* the 1.8V that the
// internal pull-up can actually reach - so the released (idle) button reads
// LOW or marginal instead of HIGH. Since Top inverts this signal for the 4K,
// a mis-read LOW becomes an asserted reset, holding the whole design in
// permanent clear with every output stuck at 0. Being marginal rather than
// flatly wrong, it also presents intermittently, which is worse to debug.
IO_LOC "i_reset" 15;
IO_PORT "i_reset" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// Connection to the external OLED SPI: SCLK 39, SDIN 40, DC 41, CS 42, with
// RES on 43 below. All five are Bank1 (VCCIO 3.3V), so every signal reaches
// the panel at a proper 3.3V logic level.
//
// Bank membership is per-pin and adjacent header pins can differ, so each one
// is worth checking against Sipeed's pinmap rather than assuming from
// proximity - i_reset on pin 15 above is exactly that trap. But 39/40 are NOT
// an instance of it: an earlier revision moved SCLK/SDIN off them believing
// they were Bank3/1.8V, which was a misreading of the pinmap. They are
// Bank1/3.3V and were always correct here.
//
// An earlier revision of this file blamed a hard state-machine freeze on pin
// placement - specifically on 44 being GCLKC_0, a global-clock input, and on
// driving several of 41/42/43/44 at once. That explanation was wrong, and it
// is recorded here only so nobody rediscovers it. The freeze reproduced with
// SCLK/SDIN moved to 16/17 and with the OLED physically disconnected, which
// rules out both pin location and panel loading. The real cause was yosys
// re-encoding the FSM to one-hot; see the Makefile's fsm_encoding note.
//
// The lesson worth keeping is the method, not the conclusion: pin placement
// and peripheral loading are easy to blame and hard to disprove, so change one
// variable per flash and keep a control channel in every measurement.
IO_LOC "o_sclk" 39;
IO_PORT "o_sclk" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "o_sdin" 40;
IO_PORT "o_sdin" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "o_cs" 42;
IO_PORT "o_cs" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "o_dc" 41;
IO_PORT "o_dc" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// Use HDMI
// IO_LOC "o_sclk" 27;
// IO_PORT "o_sclk" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
// IO_LOC "o_sdin" 28;
// IO_PORT "o_sdin" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
// IO_LOC "o_cs" 29;
// IO_PORT "o_cs" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
// IO_LOC "o_dc" 30;
// IO_PORT "o_dc" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;

// Onboard LED (the 4K's only one). Carries a free-running heartbeat, so the
// board itself reports whether the design is loaded, clocked and out of reset
// without needing any external probe or peripheral.
IO_LOC "o_led" 10;
IO_PORT "o_led" IO_TYPE=LVCMOS33 DRIVE=8;

// A diagnostic build previously exported the FSM state number on 39/40/44 and
// the heartbeat on 46. Those ports turned out to be load-bearing by accident:
// routing the state register to a module port is exactly the condition under
// which yosys declines to re-encode an FSM, so removing them let FSM_RECODE
// switch the machine to one-hot and freeze it on power-up. See the long note
// on the reset spec in lib/top.ml. The design no longer depends on that, so
// they are gone; the heartbeat stays visible on the onboard LED below.

// Drives the OLED's RES pin (active-low power-on reset pulse). See note above.
IO_LOC "o_reset" 43;
IO_PORT "o_reset" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
