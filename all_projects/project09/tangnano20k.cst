// Raspberry Pi <-> Tang Nano 20K SPI link (3.3V, mode 0, MSB first)
//
// RPi physical pin 23 (GPIO11 / SCLK) -> FPGA pin 42
// RPi physical pin 19 (GPIO10 / MOSI) -> FPGA pin 41
// RPi physical pin 24 (GPIO8  / CE0)  -> FPGA pin 51
// RPi physical pin 21 (GPIO9  / MISO) <- FPGA pin 54
// RPi physical pin 22 (GPIO25 / IRQ)  <- FPGA pin 56  (optional)
// RPi physical pin 6  (GND)           -- FPGA GND
IO_LOC "i_sclk" 42;
IO_PORT "i_sclk" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC "i_mosi" 41;
IO_PORT "i_mosi" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC "i_cs_n" 51;
IO_PORT "i_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "o_miso" 54;
IO_PORT "o_miso" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;
IO_LOC "o_irq" 56;
IO_PORT "o_irq" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;

// the six on-board LEDs
IO_LOC "leds[5]" 20;
IO_PORT "leds[5]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "leds[4]" 19;
IO_PORT "leds[4]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "leds[3]" 18;
IO_PORT "leds[3]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "leds[2]" 17;
IO_PORT "leds[2]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "leds[1]" 16;
IO_PORT "leds[1]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "leds[0]" 15;
IO_PORT "leds[0]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;

// clock and the active-high on-board reset button
IO_LOC "clock" 4;
IO_PORT "clock" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "i_reset" 87;
IO_PORT "i_reset" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
